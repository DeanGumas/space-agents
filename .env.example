# Space Agents: local configuration for development and testing.
# Copy to .env (git-ignored) and adjust. Precedence, lowest to highest:
#   space_agents/defaults.json → Settings (user overrides) → .env → real environment variables → CLI flags
# Relative paths are resolved against this file's folder. See docs/configuration.md.

# Model gateway base: the app calls {LLM_BASE_URL}/chat/completions and {LLM_BASE_URL}/models.
# A full endpoint URL (…/v1/chat/completions) is accepted too. For OpenAI: https://api.openai.com/v1
SPACE_AGENTS_LLM_BASE_URL=https://ai.example.com/api

# API key for the model gateway (dev/test only; moves to the OS keychain with onboarding). Never commit .env.
SPACE_AGENTS_API_KEY=

# Bound token use on reasoning models (minimal/low/medium/high). Dropped automatically if a model rejects it.
SPACE_AGENTS_REASONING_EFFORT=low

# Tool servers base: catalog at {MCP_BASE_URL}/mcp, servers at {MCP_BASE_URL}/mcp/{id}
SPACE_AGENTS_MCP_BASE_URL=https://ai.example.com

# Preload the Python sandbox at launch: full (~420 MB, first run <1 s), light (~210 MB), off (boots on first use).
SPACE_AGENTS_SANDBOX_WARMUP=full

# Keep test agents/history separate from your real data folder.
SPACE_AGENTS_DATA_DIR=.devdata

# Webview devtools (right-click → Inspect) and verbose logs.
SPACE_AGENTS_DEBUG=1

# Offline catalog until GET /mcp is wired up; model list for the editor (first = default):
SPACE_AGENTS_CATALOG_FILE=dev/catalog.json
SPACE_AGENTS_MODELS=gpt-5-nano
